{
  "opencollection": "1.0.0",
  "info": {
    "name": "Distru Public Assemblies Locations API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Locations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List locations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.distru.com/public/v1/locations",
            "params": [
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "1-based page number."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "Page size (max 500 for most collections)."
              }
            ]
          },
          "docs": "List locations"
        },
        {
          "info": {
            "name": "Retrieve a location",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.distru.com/public/v1/locations/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a location"
        }
      ]
    }
  ],
  "bundled": true
}